#### Verticale discretisation
## Modified verticale discretisation for stratospheric versions.
## The new version can be controled by following parameters
## Al the parameters are given in km assuming a given scalehigh
vert_sampling=strato_custom
## scale height
vert_scale=7.
## width of first layer
vert_dzmin=0.017
## dz in the low atmosphere
vert_dzlow=0.009
## height at which resolution riches dzlow
vert_z0low=2.
## dz in the mid atmosphere
vert_dzmid=1.1
## height at which resolution riches dzmid
vert_z0mid=6
## width of the transition
vert_h_mid=17
## dz in the high atmosphere
vert_dzhig=10
## height at which resolution riches dz
vert_z0hig=75.
## width of the transition
vert_h_hig=20.
## vert_prof_dissip used to choose the vertical profile
## of horizontal dissipation (values are 0 and 1)
vert_prof_dissip = 1
dissip_zref = 50
##  Avec ou sans strato
ok_strato=y
##  Activation ou non de la parametrisation de Hines pour la strato
ok_hines=n
#  Couche eponge dans les couches de pression plus faible que 100 fois la pression de la derniere couche
iflag_top_bound=2
#  Coefficient pour la couche eponge (valeur derniere couche)
tau_top_bound=5.e-4
#
